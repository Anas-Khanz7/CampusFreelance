<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Post Project - CampusFreelance</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="signup-container">

        <div class="signup-card">

            <button type="submit" class="post-project-btn">
                <span>Post Project</span>
                <span>→</span>
                </button>

                <p>Find talented students for your project.</p>

                <form action="/projects" method="POST">

                    <div class="form-group">
                        <label>Project Title</label>

                        <input type="text" name="title" placeholder="Enter project title" required>
                    </div>

                    <div class="form-group">
                        <label>Description</label>

                        <textarea name="description" placeholder="Describe your project" required></textarea>
                    </div>

                    <div class="form-group">
                        <label>Budget (₹)</label>

                        <input type="number" name="budget" placeholder="Enter budget" min="1" required>
                    </div>

                    <div class="form-group">
                        <label>Required Skills</label>

                        <input type="text" name="skills" placeholder="HTML, CSS, JavaScript" required>
                    </div>

                    <div class="form-group">
                        <label>Deadline</label>

                        <input type="date" name="deadline" required>
                    </div>

                    <button type="submit">Post Project</button>

                </form>

        </div>

    </div>

</body>

</html>