<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampusFreelance</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar">
        <h2>CampusFreelance</h2>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/projects">Projects</a>
            <a href="/login">Login</a>
            <a href="/signup" class="signup-btn">Get Started</a>
        </div>
    </nav>

    <section class="hero">

        <div class="hero-content">

            <h1>
                Turn Your Skills Into
                <span>Real Opportunities</span>
            </h1>

            <p>
                Find freelance projects, showcase your skills,
                and start building your professional career
                while studying in college.
            </p>

            <div class="hero-buttons">
                <a href="/projects" class="primary-btn">
                    Explore Projects
                </a>

                <a href="/signup" class="secondary-btn">
                    Join Now
                </a>
            </div>

        </div>

    </section>

    <section class="categories">

        <h2>Explore Categories</h2>

        <div class="category-container">

            <div class="category-card">
                💻 Web Development
            </div>

            <div class="category-card">
                🎨 Graphic Design
            </div>

            <div class="category-card">
                ✍️ Content Writing
            </div>

            <div class="category-card">
                📱 App Development
            </div>

        </div>

    </section>

</body>
</html>